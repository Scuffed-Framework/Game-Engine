// Aerial perspective froxel volume (AtmoLUTs::GetAerialPerspectiveLUT, baked every frame in AtmosphereSFERenderpass::PreRender).
// Indexed by SCREEN uv: the bake uses the same invProj/invView as this pass, so a ray's full-res uv works as-is.
[[vk::binding(30, 0)]]
Sampler3D inAerialPerspColorRGBTransR; // rgb = in-scatter (already x sun illuminance), a = T.r
[[vk::binding(32, 0)]]
Sampler3D inAerialPerspTransGB;        // rg = T.gb
[[vk::binding(33, 0)]]
Sampler2D inAerialPerspRange;          // r = distToTravel of this ray (<0: ray misses the atmosphere)

[[vk::binding(31, 0)]]
ConstantBuffer<Camera> kCam;

const static int kBayer4x4[16] = {
    0, 8, 2, 10,
    12, 4, 14, 6,
    3, 11, 1, 9,
    15, 7, 13, 5
};

struct CloudUBO
{
    float cloudBottomRadius;
    float cloudTopRadius;
    float stepCount;
    float lightStepCount;

    float cloudDensityScale;
    float cloudCoverage;

    float time;

    float sdfRangeMetres;
    int frameIndex;

    float cloudDetailScale;
    float cloudBaseNoiseScale;
    float cloudCurlNoiseScale;

    float cloudWeatherUVScale;
    float precipitationBias;
    float FadeDistance2d;
    float fadeSmoothDist;
    
    float2 Wind;
    float Speed;
    float unused;

    // Wrenninge "Oz" multiple-scattering octaves
    float msAttenuation;      // a: extinction falloff per octave
    float msContribution;     // b: energy weight per octave
    float msPhaseAttenuation; // c: eccentricity falloff per octave, g_n = g * (1 - c)^n
    float msOctaves;

    // 2D <-> volumetric altitude crossfade (metres above sea level, see getVolumetricsFadeout) and 2D column sample count
    float transitionStartAltitude;
    float transitionEndAltitude;
    float twoDColumnSamples;
    float reserved0;
};

float saturate(float x) { return clamp(x, 0.0, 1.0); }
float3 saturate(float3 x) { return clamp(x, 0.0, 1.0); }
float mean(float3 x) { return (x.x + x.y + x.z) / 3.0; }

float3 safeNormalize(float3 v, float3 fallback)
{
    float lenSq = dot(v, v);
    return (lenSq > 1e-10) ? v * rsqrt(lenSq) : fallback;
}

float2 safeNormalize(float2 v, float2 fallback)
{
    float lenSq = dot(v, v);
    return (lenSq > 1e-10) ? v * rsqrt(lenSq) : fallback;
}

float getDensity(float heightMeter)
{
    return exp(-heightMeter * 0.001) * 0.001 * 0.001;
}

float remap(float value, float orignalMin, float orignalMax, float newMin, float newMax)
{
    return newMin + (saturate((value - orignalMin) / (orignalMax - orignalMin)) * (newMax - newMin));
}

float raySphereIntersectNearest(float3 origin, float3 direction, float3 center, float radius)
{
    float3 oc = origin - center;
    float b = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float disc = b * b - c;
    if (disc < 0.0) return -1.0;
    float sqrtDisc = sqrt(disc);
    float t = -b - sqrtDisc;
    return t > 0.0 ? t : -1.0;
}

float raySphereIntersectInside(float3 origin, float3 direction, float3 center, float radius)
{
    float3 oc = origin - center;
    float b = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float disc = b * b - c;
    if (disc < 0.0) return -1.0;
    float sqrtDisc = sqrt(disc);
    float t = -b + sqrtDisc;
    return t > 0.0 ? t : -1.0;
}

bool raySphereIntersectOutSide(float3 origin, float3 direction, float3 center, float radius, out float2 t0t1)
{
    float3 oc = origin - center;
    float b = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float disc = b * b - c;
    if (disc < 0.0) { t0t1 = float2(0.0, 0.0); return false; }
    float sqrtDisc = sqrt(disc);
    t0t1.x = -b - sqrtDisc;
    t0t1.y = -b + sqrtDisc;
    return t0t1.y > 0.0;
}

float3 cloudTypeGradient(float type, float normalizeHeight)
{
    // No bottom ramp in the profiles: a ramp BEFORE the coverage threshold makes the base's height depend on the noise (ragged,
    // soft underside). The base is cut by a steep ramp AFTER the threshold (densityShape) instead, giving a flat base, while the
    // falling top of each profile is thresholded against the noise, giving domed, billowy tops.
    float stratus = remap(normalizeHeight, 0.15, 0.30, 1.0, 0.0);
    float stratocumulus = remap(normalizeHeight, 0.20, 0.55, 1.0, 0.0);
    float cumulus = remap(normalizeHeight, 0.10, 0.80, 1.0, 0.2);

    float a = saturate(type * 2.0);
    float b = saturate(type * 2.0 - 1.0);
    return float3(lerp(stratus, stratocumulus, a), lerp(stratocumulus, cumulus, b), 0);
}

float getUniformPhase() { return 1.0 / (4.0 * 3.14159265); }

// Draine phase: HG with an extra cos^2 term (better back-scatter for larger spherical droplets).
float drainePhase(float nu, float g, float alpha)
{
    const float g2 = g * g;
    const float numerator = (1.0 - g2) * (1.0 + alpha * nu * nu);
    const float bottomTerm = 1.0 + g2 - 2.0 * g * nu;
    const float denominator = pow(max(bottomTerm, 1e-6), 1.5) * (1.0 + alpha * (1.0 + 2.0 * g2) / 3.0) * 4.0 * 3.14159265;
    return numerator / denominator;
}

// Jendersie & d'Eon (2023), "An Approximate Mie Scattering Function for Fog and Cloud Rendering" (SIGGRAPH 2023):
// a weighted blend of an HG forward peak and a Draine lobe, fitted to Mie for water droplets of diameter d (microns, 5..50).
// nu = cos(scattering angle); +1 = forward (looking into the sun).
float jendersieDEonPhase(float nu, float dropletDiameter)
{
    const float d = clamp(dropletDiameter, 5.0, 50.0);

    const float gHG = exp(-0.0990567 / (d - 1.67154));
    const float gD = exp(-2.20679 / (d + 3.91029)) - 0.428934;
    const float alpha = exp(3.62489 - 8.29288 / (d + 5.52825));
    const float wD = exp(-0.599085 / (d - 0.641583)) - 0.665888;

    return (1.0 - wD) * hgPhase(gHG, nu) + wD * drainePhase(nu, gD, alpha);
}
// VoL = dot(viewDir, sunDir): +1 means looking INTO the sun (forward scatter / silver lining)
// Phase for MS octave n. eccScale = (1 - c)^n (1.0 = the real single-scatter phase). Octave 0 is the approximate-Mie phase; higher
// octaves relax toward isotropic by eccScale, which is Wrenninge's g*c^n generalised to a phase that is not a single HG.
float cloudPhaseOctave(float VoL, float eccScale)
{
    return lerp(getUniformPhase(), jendersieDEonPhase(VoL, kCloudDropletDiameter), eccScale);
}

float cloudPhase(float VoL)
{
    return cloudPhaseOctave(VoL, 1.0);
}

float dualLobPhase(float forward, float backward, float mixFactor, float VoL)
{
    float phase = (1.0 - mixFactor) * (1.0 + forward * VoL) / (4.0 * 3.14159);
    phase += mixFactor * (1.0 + backward * VoL) / (4.0 * 3.14159);
    return phase;
}

float hgPhase(float g, float cosTheta)
{
    float denom = 1.0 + g * g - 2.0 * g * cosTheta;
    return (1.0 - g * g) / (4.0 * 3.14159 * denom * sqrt(denom));
}

float rayleighPhase(float cosTheta)
{
    return 3.0 * (1.0 + cosTheta * cosTheta) / (16.0 * 3.14159);
}

float getPowderEffect(float depth, float height, float VoL)
{
    float r = VoL * 0.5 + 0.5;
    r = r * r;
    height = height * (1.0 - r) + r;
    return depth * height;
}

// Mip level whose texel is about one march step wide. tilesPerKm = noise tiles per km (cloudBaseNoiseScale / cloudDetailScale).
float cloudNoiseLod(float footprintMetres, float tilesPerKm)
{
    const float texelMetres = 1000.0 / (max(tilesPerKm, 1e-4) * kCloudNoiseRes);
    return clamp(log2(max(footprintMetres, 1e-3) / texelMetres) - kNoiseLodBias, 0.0, 6.0);
}

// posMeter: world position in METERS (absolute from planet center)
// normalizeHeight: 0=cloud bottom, 1=cloud top
// footprint: march step length in metres at this sample; picks the noise mip and fades the detail erosion that the step can't resolve
float cloudMapEx(float3 posMeter, float normalizeHeight, bool coarse, float footprint)
{
    const float kCoverage = kCloud.cloudCoverage;
    const float kDensity = kCloud.cloudDensityScale;

    const float3 windDirection = float3(kCloud.Wind.x, 0.0, kCloud.Wind.y);
    const float cloudSpeed = kCloud.Speed;

    posMeter += windDirection * normalizeHeight * 500.0;
    float3 posKm = posMeter * 0.001; // Convert to km for noise lookups

    float3 windOffset = (windDirection + float3(0.0, 0.1, 0.0)) * kCloud.time * cloudSpeed;

    float2 sampleUv = posKm.xz * kCloud.cloudWeatherUVScale;
    float4 weatherValue = inWeatherTexture.SampleLevel(linearRepeatSampler, sampleUv, 0);

    float localCoverage = inCloudCurlNoise.SampleLevel(linearRepeatSampler, (kCloud.time * cloudSpeed * 50.0 + posMeter.xz) * 0.000001 + 0.5, 0).x;
    localCoverage = saturate(localCoverage * 3.0 - 0.75) * 0.2;

    // weather.x is now a contrast-stretched 0..1 (mean ~0.5); kCoverage*2 makes the slider's default 0.5 mean "average".
    float coverage = saturate(kCoverage * 2.0 * (localCoverage + weatherValue.x));
    
    // weather.g = how tall this cloud is: stretch the type profile over [0, cloudTop] so towers and shallow cumulus coexist
    const float cloudTop = lerp(0.35, 1.0, weatherValue.g);
    const float hh = saturate(normalizeHeight / cloudTop);
    float3 g = cloudTypeGradient(weatherValue.b, hh); 
    float gradienShape = (weatherValue.b < 0.5 ? g.x : g.y) * remap(hh, 0.85, 1.0, 1.0, 0.0);

    float basicNoise = inBasicNoise.SampleLevel(linearRepeatMipFilterSampler, (posKm + windOffset) * float3(kCloud.cloudBaseNoiseScale), cloudNoiseLod(footprint, kCloud.cloudBaseNoiseScale)).x;
    float basicCloudNoise = gradienShape * basicNoise;

    float basicCloudWithCoverage = coverage * remap(basicCloudNoise, 1.0 - coverage, 1, 0, 1);

    // Erosion only removes density, so skipping it for the coarse (search) sample gives a conservative upper bound.
    float detailNoiseMixByHeight = 0.0;
    if (!coarse)
    {
        float3 sampleDetailNoise = posKm - windOffset * 0.15;
        // Detail finer than the step is undersampled and only turns into per-pixel noise: fade it out between 0.5 and 1.5 detail
        // wavelengths per step, regressing to its mean so the average density doesn't shift.
        const float detailWavelength = 1000.0 / (max(kCloud.cloudDetailScale, 1e-4) * kDetailBandCells);
        const float detailFade = 1.0 - saturate(footprint / detailWavelength - 0.5);
        float detailNoiseComposite = lerp(0.45,
            inDetailNoise.SampleLevel(linearRepeatMipFilterSampler, sampleDetailNoise * kCloud.cloudDetailScale, cloudNoiseLod(footprint, kCloud.cloudDetailScale)).x,
            detailFade);
        detailNoiseMixByHeight = kDetailErosion * exp(-kCoverage * 0.75) * lerp(detailNoiseComposite, 1 - detailNoiseComposite, saturate(normalizeHeight * 10.0));
    }

    // Base: dense and sharply cut (was 0.01 + h*1.15 with a 10% ramp, which left a thin, translucent, soft underside).
    float densityShape = saturate(0.4 + normalizeHeight * 0.75) * kDensity *
        remap(normalizeHeight, 0.0, 0.04, 0.0, 1.0) *
        remap(normalizeHeight, 0.8, 1.0, 1.0, 0.0);

    float cloudDensity = saturate(remap(basicCloudWithCoverage, detailNoiseMixByHeight, 1.0, 0.0, 1.0) * kDensityContrast);
    return cloudDensity * densityShape * kExtinctionPerMetre;
}

float cloudMap(float3 posMeter, float normalizeHeight) { return cloudMapEx(posMeter, normalizeHeight, false, 0.0); }
float cloudMapCoarse(float3 posMeter, float normalizeHeight) { return cloudMapEx(posMeter, normalizeHeight, true, 0.0); }
// Step-aware variants (noise mip + detail fade follow the step length)
float cloudMapFP(float3 posMeter, float normalizeHeight, float footprint) { return cloudMapEx(posMeter, normalizeHeight, false, footprint); }
float cloudMapCoarseFP(float3 posMeter, float normalizeHeight, float footprint) { return cloudMapEx(posMeter, normalizeHeight, true, footprint); }

// HZD light-sample cone kernel: 6 roughly uniform unit vectors. Each light sample is pushed off the ray by kernel * distance *
// kLightConeSpread, so the shadow is a cone instead of a line: soft shadows that the temporal reconstruction averages out.
const static float3 kLightConeKernel[6] = {
    float3( 0.38051305,  0.92453449, -0.02111345),
    float3(-0.50625799, -0.03590792, -0.86163418),
    float3(-0.32509218, -0.94557439,  0.01428793),
    float3( 0.09026238, -0.27376545,  0.95755165),
    float3( 0.28128598,  0.42443639, -0.86065785),
    float3(-0.16852403,  0.14748697,  0.97460106)
};

// Optical depth (dimensionless: extinction in 1/m integrated over metres) from `pos` along `dir` through the cloud layer.
// ONE march feeds every multiple-scattering octave: octave n simply sees od * a^n (Wrenninge), so the octave
// count costs no extra cloudMap taps. pos: world position in METERS (absolute from planet center).
float cloudLightOpticalDepth(float3 pos, float3 dir, int lightSteps, bool longRange)
{
    const float layerThickness = kCloud.cloudTopRadius - kCloud.cloudBottomRadius;
    float stepL = layerThickness / float(lightSteps) / 16.0; // FIRST step; grows by kLightStepMul
    float travelled = 0.0;
    float od = 0.0;

    for (int j = 0; j < lightSteps; j++)
    {
        const float d = travelled + 0.5 * stepL;
        float3 samplePos = pos + dir * d + kLightConeKernel[j % 6] * (d * kLightConeSpread);
        float normalizeHeight = (length(samplePos) - kCloud.cloudBottomRadius) / layerThickness;
        od += cloudMapFP(samplePos, normalizeHeight, stepL) * stepL;
        travelled += stepL;
        stepL *= kLightStepMul;
    }

    if (longRange)
    {
        // HZD: one extra sample well past the march (shadows cast by neighbouring bulges / other cumulus), standing in for the
        // span [travelled, 3*travelled]. Weighted down: a single tap over that length would otherwise be all-or-nothing.
        const float d = 2.0 * travelled;
        float3 samplePos = pos + dir * d + kLightConeKernel[lightSteps % 6] * (d * kLightConeSpread);
        float normalizeHeight = (length(samplePos) - kCloud.cloudBottomRadius) / layerThickness;
        od += cloudMapFP(samplePos, normalizeHeight, 2.0 * travelled) * (2.0 * travelled) * kFarShadowWeight;
    }
    return od;
}

// Beer-Powder (Schneider, HZD): E = 2 * exp(-d) * (1 - exp(-2d)) with d = optical depth along the LIGHT ray. exp(-d) is applied by
// the octave sum; this is the (1 - exp(-2d)) powder factor. It darkens the thin, sun-facing skin where little light has had a
// chance to scatter in, and only reads when looking AWAY from the sun, so it fades out toward the sun (silver lining wins there).
float cloudPowder(float odSun, float VoL)
{
    float r = saturate(VoL * 0.5 + 0.5);
    r = r * r;
    return lerp(2.0 * (1.0 - exp(-2.0 * odSun)), 1.0, r);
}

// Wrenninge et al. multiple-scattering octaves (Sony Imageworks, Oz the Great and Powerful):
//   L = sum_n  b^n * phase(g * (1-c)^n) * exp(-od * a^n)
// a = attenuation (light penetrates deeper each octave), b = contribution (energy per octave), c = phase attenuation.
// `powder` fully multiplies octave 0 and fades in progressively less on higher octaves (1/(1+n)): scattered-in light from deeper
// octaves should still fill thin rims, just not as brightly as an unpowdered sum would.
// Returns the phase-weighted sun visibility; multiply by the sun colour.
float cloudMultiScatterSun(float od, float VoL, float powder)
{
    const int octaves = clamp((int)kCloud.msOctaves, 1, kMaxMsOctaves);
    float a = 1.0;
    float b = 1.0;
    float ecc = 1.0;
    float L = 0.0;

    for (int n = 0; n < octaves; n++)
    {
        const float phase = cloudPhaseOctave(VoL, ecc);
        const float beers = exp(-od * a);
        L += b * phase * beers * lerp(1.0, powder, 1.0 / float(1 + n));

        a *= kCloud.msAttenuation;
        b *= kCloud.msContribution;
        ecc *= 1.0 - kCloud.msPhaseAttenuation;
    }
    return L;
}

// Same octave series for the sky/ambient term: isotropic, so no phase and no powder.
float cloudMultiScatterSky(float od)
{
    const int octaves = clamp((int)kCloud.msOctaves, 1, kMaxMsOctaves);
    float a = 1.0;
    float b = 1.0;
    float L = 0.0;

    for (int n = 0; n < octaves; n++)
    {
        L += b * exp(-od * a);
        a *= kCloud.msAttenuation;
        b *= kCloud.msContribution;
    }
    return L;
}

// Aerial perspective between the camera and a cloud hit, from the same froxel volume the geometry path uses
// (Atmosphere.shader::sampleAerialPerspective). uv = screen uv of this ray, dist = metres from the camera to the hit.
void sampleCloudAerialPerspective(float2 uv, float dist, float3 camPos, float3 dir, float topRadius,
                                  out float3 outScatter, out float3 outTransmit)
{
    outScatter = float3(0.0);
    outTransmit = float3(1.0);

    const float maxDist = inAerialPerspRange.SampleLevel(uv, 0.0).r;
    if (!(maxDist > 0.0))
        return; // ray misses the atmosphere (bake wrote -1), or the range texel is NaN

    // The bake uses quadratic slices (p*p*maxDist) only while the camera is inside the atmosphere, linear slices from
    // space, and measures distance from the atmosphere ENTRY point when starting outside it.
    const bool insideAtmo = length(camPos) < topRadius;
    float d = dist;
    if (!insideAtmo)
        d = max(dist - max(raySphereIntersect(camPos, dir, topRadius).x, 0.0), 0.0);

    float t = saturate(d / maxDist);
    if (insideAtmo)
        t = sqrt(t);

    uint lutW, lutH, lutD;
    inAerialPerspColorRGBTransR.GetDimensions(lutW, lutH, lutD);
    const float sliceCount = float(max(lutD, 1u));

    // Slice i holds the accumulation out to ((i+1)/N)^2 * maxDist but texel i is CENTRED at (i+0.5)/N, so sample at
    // t - 0.5/N; closer than slice 0's far edge, fade in from nothing (optical depth is linear over a short run).
    float nearFade = saturate(t * sliceCount);
    if (insideAtmo)
        nearFade *= nearFade;
    const float w = clamp(t - 0.5 / sliceCount, 0.5 / sliceCount, 1.0 - 0.5 / sliceCount);

    const float4 ct = inAerialPerspColorRGBTransR.SampleLevel(float3(uv, w), 0.0);
    const float2 tgb = inAerialPerspTransGB.SampleLevel(float3(uv, w), 0.0).rg;

    const float3 scatter = ct.rgb * nearFade;
    const float3 transmit = saturate(lerp(float3(1.0), float3(ct.a, tgb.x, tgb.y), nearFade));

    // The very first bake (AtmoLUTs ctor) runs with a zeroed frame UBO and writes NaN; never let that reach the cloud RT.
    if (any(isnan(scatter)) || any(isinf(scatter)) || any(isnan(transmit)))
        return;

    outScatter = scatter;
    outTransmit = transmit;
}

// Altitude crossfade between the volumetric march and the 2D layer. Ported from the reference's GetVolumetricsFadeout:
// below transitionStart: volumetric only. The 2D layer is fully in by 25% of the way to transitionEnd, the volumetric layer
// holds until 25% and is gone at transitionEnd. Above transitionEnd: 2D only (and the raymarch is skipped entirely).
void getVolumetricsFadeout(float camAltitude, float startAltitude, float endAltitude,
                           out float volumetricLayerFade, out float twoDimensionalLayerFade)
{
    const float transitionProgress = 1.0 - (camAltitude - startAltitude) / max(endAltitude - startAltitude, 1.0);
    twoDimensionalLayerFade = clamp(4.0 * (1.0 - transitionProgress), 0.0, 1.0);
    volumetricLayerFade = clamp(1.33 * transitionProgress, 0.0, 1.0);
}

// Optical depth of the cloud column through `up` (a direction from the planet centre): evenly spaced cloudMap samples between
// cloud base and top. This is the whole "2D layer": the SAME density field the volumetric march uses, integrated along local
// vertical instead of along the view ray, so the two layers show the same clouds and the crossfade is seamless.
float cloudColumnOpticalDepth(float3 up, int samples)
{
    const float thickness = kCloud.cloudTopRadius - kCloud.cloudBottomRadius;
    samples = clamp(samples, 2, 16);
    float od = 0.0;
    for (int k = 0; k < samples; k++)
    {
        const float h = (float(k) + 0.5) / float(samples);
        od += cloudMapEx(up * (kCloud.cloudBottomRadius + h * thickness), h, false, thickness / float(samples)) * (thickness / float(samples));
    }
    return od;
}

// Iterations needed to march [t0, t1] with step = max(minStep, g * t): a linear phase at minStep until g*t overtakes it, then
// geometric growth by (1 + g) per step.
float cloudMarchStepsNeeded(float t0, float t1, float minStep, float g)
{
    const float tCross = minStep / g;
    float t = t0;
    float steps = 0.0;
    if (t < tCross)
    {
        const float tLin = min(t1, tCross);
        steps += (tLin - t) / minStep;
        t = tLin;
    }
    if (t < t1)
        steps += log(t1 / max(t, 1e-3)) / log(1.0 + g);
    return steps;
}

float4 cloudColorCompute(
    CloudUBO cloud,
    AtmoUBO atmosphere,
    float2 uv,
    float blueNoise,
    inout float cloudZ,
    int2 workPos,
    float3 worldDir,
    bool bFog,
    inout float4 lightingFog,
    float fogNoise)
{
    float3 worldPos = kAtmo.cameraPos.xyz-kAtmo.planetPos.xyz;

    lightingFog.w = -1.0;

    float earthRadius = atmosphere.bottomRadius;
    float radiusCloudStart = cloud.cloudBottomRadius;
    float radiusCloudEnd = cloud.cloudTopRadius;

    float viewHeight = length(worldPos);

    // 2D <-> volumetric crossfade by camera altitude above sea level.
    float volumetricFade, twoDimensionalFade;
    getVolumetricsFadeout(viewHeight - earthRadius, cloud.transitionStartAltitude, cloud.transitionEndAltitude,
                          volumetricFade, twoDimensionalFade);

    // Distance (metres) to the scene surface along this ray. The march is clipped here so geometry inside or in front of the
    // layer is correctly covered by (and covers) cloud, instead of being skipped or seen straight through it.
    float sceneDist = 1.0e30;
    {
        const float sceneZ = inDepth.SampleLevel(pointClampEdgeSampler, uv, 0).x;
        if (sceneZ > 0.0)
        {
            const float4 vp = mul(atmosphere.invProj, float4(uv * 2.0 - 1.0, sceneZ, 1.0));
            sceneDist = length(vp.xyz / vp.w) * (atmosphere.bottomRadius / atmosphere.renderUnitRadius);
        }
    }

    float tMin;
    float tMax;
    bool bEarlyOutCloud = false;

    if (viewHeight < radiusCloudStart)
    {
        // Camera inside atmosphere, below clouds
        float tEarth = raySphereIntersectNearest(worldPos, worldDir, float3(0.0), earthRadius);
        if (tEarth > 0.0)
        {
            bEarlyOutCloud = true;
        }

        tMin = raySphereIntersectInside(worldPos, worldDir, float3(0.0), radiusCloudStart);
        tMax = raySphereIntersectInside(worldPos, worldDir, float3(0.0), radiusCloudEnd);
    }
    else if (viewHeight > radiusCloudEnd)
    {
        // Camera above clouds (space)
        float2 t0t1;
        const bool bIntersectionEnd = raySphereIntersectOutSide(worldPos, worldDir, float3(0.0), radiusCloudEnd, t0t1);
        if (!bIntersectionEnd)
        {
            bEarlyOutCloud = true;
        }

        float2 t2t3;
        const bool bIntersectionStart = raySphereIntersectOutSide(worldPos, worldDir, float3(0.0), radiusCloudStart, t2t3);
        if (bIntersectionStart)
        {
            tMin = t0t1.x;
            tMax = t2t3.x;
        }
        else
        {
            tMin = t0t1.x;
            tMax = t0t1.y;
        }
    }
    else
    {
        // Camera inside cloud layer
        float tStart = raySphereIntersectNearest(worldPos, worldDir, float3(0.0), radiusCloudStart);
        if (tStart > 0.0)
        {
            tMax = tStart;
        }
        else
        {
            tMax = raySphereIntersectInside(worldPos, worldDir, float3(0.0), radiusCloudEnd);
        }
        tMin = 0.0;
    }

    tMin = max(tMin, 0.0);
    tMax = max(tMax, 0.0);

    if (sceneDist <= tMin)
        bEarlyOutCloud = true; // geometry is in front of the whole layer along this ray
    tMax = min(tMax, sceneDist);

    if (volumetricFade <= 0.0)
        bEarlyOutCloud = true; // above the transition only the 2D layer is drawn: skip the march

    float cloudMaxTracingDist = 300000.0; // 300km max trace
    if (tMax <= tMin || tMin > cloudMaxTracingDist)
    {
        bEarlyOutCloud = true;
    }

    const float marchingDistance = min(cloudMaxTracingDist, tMax - tMin);
    tMax = tMin + marchingDistance;

    const float StepCount = max(cloud.stepCount, 1.0);
    const uint stepCountUnit = (uint)StepCount;

    // Variable step length: step = marchGrowth * t, never below minStep. marchGrowth is the smallest rate (>= kStepGrowth) whose
    // geometric series still reaches tMax inside ~60% of the iteration budget (the rest is for coarse-search back-ups).
    // The fixed 5% rate used to run out of iterations after ~8 km when tMin ~ 0 (camera inside the layer), leaving everything
    // beyond transparent: a hard, blocky "edge of the volumetric" that overwrote the clouds behind it.
    const float minStep = max(30.0, (radiusCloudEnd - radiusCloudStart) / StepCount * 0.6);
    const float maxStep = max(minStep, 0.5 * marchingDistance);

    float marchGrowth = kStepGrowth;
    {
        const float budget = 0.6 * StepCount;
        if (cloudMarchStepsNeeded(tMin, tMax, minStep, kStepGrowth) > budget)
        {
            float gLo = kStepGrowth;
            float gHi = 8.0;
            for (int it = 0; it < 12; it++)
            {
                const float gMid = 0.5 * (gLo + gHi);
                if (cloudMarchStepsNeeded(tMin, tMax, minStep, gMid) > budget)
                    gLo = gMid;
                else
                    gHi = gMid;
            }
            marchGrowth = gHi;
        }
    }

    float sampleT = tMin + 0.001 * minStep;
    sampleT += clamp(tMin * marchGrowth, minStep, maxStep) * blueNoise;

    float3 sunColor = float3(kCloudSunIlluminance * kCloudSunBoost); // phase has a 1/(4*pi) factor, so the sun needs a gain to compete with the sky LUT
    float3 sunDirection = normalize(kAtmo.sunDir.xyz);

    float VoL = dot(worldDir, sunDirection);

    float3 skyBackgroundColor = GetSkyAmbientColor(worldPos, sunDirection, viewHeight, atmosphere.bottomRadius, inSkyViewLut);

    float transmittance = 1.0;
    float3 scatteredLight = float3(0.0, 0.0, 0.0);
    float3 dbgVal = float3(0.0, 0.0, 0.0);
    bool dbgSet = false;

    float3 groundToCloudTransfertIsoScatter;
    {
        float3 upVector = worldPos / viewHeight;
        float cosSunZenith = dot(upVector, sunDirection);
        groundToCloudTransfertIsoScatter = sampleMultiScatter(
            inMultiScatterLUT, viewHeight, cosSunZenith,
            atmosphere.bottomRadius, atmosphere.topRadius);
    }

    if (!bEarlyOutCloud)
    {
        float3 rayHitPos = float3(0.0);
        float rayHitPosWeight = 0.0;

        float3 atmosphereTransmittance0;
        {
            float3 samplePos = sampleT * worldDir + worldPos;
            float sampleHeight = length(samplePos);
            const float3 upVector = samplePos / sampleHeight;
            float viewZenithCosAngle = dot(sunDirection, upVector);
            float2 sampleUv = atmosUV(viewHeight, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius);
            atmosphereTransmittance0 = inTransmittanceLut.SampleLevel(linearClampEdgeSampler, atmosUV(sampleHeight, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius), 0).rgb; // sampleHeight, NOT camera viewHeight: cloud at 1.5-6km still sees a low sun
        }

        float3 atmosphereTransmittance1;
        {
            float3 samplePos = tMax * worldDir + worldPos;
            float sampleHeight = length(samplePos);
            const float3 upVector = samplePos / sampleHeight;
            float viewZenithCosAngle = dot(sunDirection, upVector);
            float2 sampleUv = atmosUV(viewHeight, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius);
            atmosphereTransmittance1 = inTransmittanceLut.SampleLevel(linearClampEdgeSampler, atmosUV(sampleHeight, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius), 0).rgb;
        }

        float3 upScaleColor;
        {
            float3 samplePos = sampleT * worldDir + worldPos;
            float sampleHeight = length(samplePos);
            float3 sampleUp = samplePos / sampleHeight;
            float cosSunZenithLocal = dot(sampleUp, sunDirection);
            upScaleColor = sampleMultiScatter(inMultiScatterLUT, sampleHeight, cosSunZenithLocal,
                                              atmosphere.bottomRadius, atmosphere.topRadius);
        }

        float lastCoarseDt = 0.0;
        bool coarseMode = true; // HZD: search with big, cheap steps until cloud is found, then go fine
        uint emptyRun = 0u;

        for (uint i = 0; i < stepCountUnit; i++)
        {
            if (sampleT >= tMax)
                break;

            const float dtFine = clamp(sampleT * marchGrowth, minStep, maxStep);

            float3 samplePos = sampleT * worldDir + worldPos;
            float sampleHeight = length(samplePos);
            float normalizeHeight = (sampleHeight - cloud.cloudBottomRadius) / (cloud.cloudTopRadius - cloud.cloudBottomRadius);

            if (coarseMode)
            {
                if (cloudMapCoarseFP(samplePos, normalizeHeight, dtFine * kCoarseStepMul) > 0.0)
                {
                    // Found something: back up over the span the last coarse step skipped and march fine from there.
                    coarseMode = false;
                    emptyRun = 0u;
                    sampleT = max(tMin, sampleT - lastCoarseDt);
                    lastCoarseDt = 0.0;
                }
                else
                {
                    lastCoarseDt = dtFine * kCoarseStepMul;
                    sampleT += lastCoarseDt;
                }
                continue;
            }

            const float stepT = dtFine;

            float3 atmosphereTransmittance = lerp(atmosphereTransmittance0, atmosphereTransmittance1, saturate((sampleT - tMin) / marchingDistance));

            float stepCloudDensity = cloudMapFP(samplePos, normalizeHeight, stepT);

            if (stepCloudDensity > 0.0)
            {
                emptyRun = 0u;

                // stepT is in meters, density is per meter, so opticalDepth is dimensionless
                float opticalDepth = stepCloudDensity * stepT;
                // Plain Beer-Lambert for the VIEW ray. The old max(exp(-od), exp(-od*0.25)*0.7) is a light-energy hack (it is the
                // two-term multi-scatter fudge, which the Oz octaves now do properly); on the view ray it made dense cloud
                // see-through, so interiors smeared together and silhouettes went soft.
                float stepTransmittance = exp(-opticalDepth);

                // Cloud "hit" position (feeds cloudZ for reprojection and the aerial-perspective distance): weight each
                // step by the opacity it contributes. It used to be accumulated before the density test, so empty steps
                // voted too and the hit landed mid-way along the whole empty ray instead of at the cloud.
                const float hitWeight = transmittance * (1.0 - stepTransmittance);
                rayHitPos += samplePos * hitWeight;
                rayHitPosWeight += hitWeight;

                const int lightSteps = (int)cloud.lightStepCount;
                const float3 sampleUp = samplePos / sampleHeight;
                const float odSun = cloudLightOpticalDepth(samplePos, sunDirection, lightSteps, true);
                const float odSky = cloudLightOpticalDepth(samplePos, sampleUp, lightSteps, false); // sky light comes from ABOVE: radial up at the sample, not world +Y (they diverge ~2.5 deg at 280 km)

                // In-scatter probability: how "inside" the cloud this sample is (thin rims ~0). Scales the ambient terms so wispy
                // edges don't glow brighter than the body.
                float inScatterProb;
                {
                    float densityN = stepCloudDensity / kExtinctionPerMetre;
                    float depthProbability = pow(clamp(densityN * 8.0, 0.0, 1.0), remap(normalizeHeight, 0.3, 0.85, 0.5, 2.0));
                    inScatterProb = saturate(depthProbability + 0.05);
                }

                // HZD Beer-Powder on the light ray (see cloudPowder).
                const float powder = cloudPowder(odSun, VoL);

                float3 sunlightTerm = atmosphereTransmittance * sunColor;

                // Multiple-scattering octave sums (Wrenninge/Oz): sun = sum b^n * dualHG(g c^n) * beers(od a^n), Beer-Powder on the light ray.
                const float sunMs = cloudMultiScatterSun(odSun, VoL, powder);
                const float skyMs = cloudMultiScatterSky(odSky);

                float3 groundLit = lerp(skyBackgroundColor, groundToCloudTransfertIsoScatter * kCloudSunIlluminance, saturate(1.0 - normalizeHeight))
                    * saturate(1.0 - kGroundOcc + normalizeHeight) * 1.0;

                float3 ambientLit = upScaleColor * kCloudSunIlluminance * kAmbientScale
                    * lerp(0.3, 1.0, saturate(normalizeHeight * 1.5))
                    * (0.5 + 0.5 * (1.0 - sunDirection.y));

                // Desaturate the sky-coloured fill terms toward their luma (see kAmbientSaturation).
                ambientLit = lerp(dot(ambientLit, float3(0.2126, 0.7152, 0.0722)).xxx, ambientLit, kAmbientSaturation);
                groundLit  = lerp(dot(groundLit, float3(0.2126, 0.7152, 0.0722)).xxx, groundLit, kAmbientSaturation);

                #if CLOUD_LIGHT_DEBUG != 0
                if (!dbgSet)
                {
                    dbgSet = true;
#if CLOUD_LIGHT_DEBUG == 1
                    dbgVal = exp(-odSun).xxx;
#elif CLOUD_LIGHT_DEBUG == 2
                    dbgVal = ambientLit;
#elif CLOUD_LIGHT_DEBUG == 3
                    dbgVal = groundLit;
#elif CLOUD_LIGHT_DEBUG == 4
                    dbgVal = skyBackgroundColor;
#elif CLOUD_LIGHT_DEBUG == 5
                    dbgVal = sunlightTerm * cloudPhase(VoL) * powder;
#elif CLOUD_LIGHT_DEBUG == 6
                    dbgVal = (stepCloudDensity * stepT / 5.0).xxx;
#elif CLOUD_LIGHT_DEBUG == 7
                    dbgVal = upScaleColor;
#elif CLOUD_LIGHT_DEBUG == 8
                    dbgVal = sunDirection * 0.5 + 0.5;
#elif CLOUD_LIGHT_DEBUG == 10
                    dbgVal = sunlightTerm * sunMs;
#elif CLOUD_LIGHT_DEBUG == 11
                    dbgVal = (skyMs * 0.25).xxx;
#elif CLOUD_LIGHT_DEBUG == 9
                    {
                        // QUADRANTS (shown as 1-exp(-4x) so tiny values are visible):
                        // TL ambientLit | TR groundLit | BL sun term (unshadowed) | BR skyBackgroundColor
                        float3 sunTerm = sunlightTerm * cloudPhase(VoL) * powder;
                        bool qr = uv.x >= 0.5;
                        bool qb = uv.y >= 0.5;
                        float3 pick = skyBackgroundColor;
                        if (!qb && !qr) pick = ambientLit;
                        else if (!qb && qr) pick = groundLit;
                        else if (qb && !qr) pick = sunTerm;
                        dbgVal = pick; // RAW HDR value: hover a pixel in RenderDoc and read it
                    }
#endif
                }
#endif
                // Beer-Lambert visibility x dual-lobe HG x Wrenninge MS octaves. Energy-conserving integration over the step:
                // S is the in-scattered radiance at the sample, (S - S*T_step)/sigmaE integrates it across the step's extinction.
                const float3 albedo = float3(1.0);
                const float sigmaS = stepCloudDensity;
                const float sigmaE = max(sigmaS, 1e-8);

                const float3 luminance = sunlightTerm * sunMs + ambientLit * skyMs * lerp(0.35, 1.0, inScatterProb) + groundLit;
                const float3 S = sigmaS * albedo * luminance;

                scatteredLight += transmittance * (S - S * stepTransmittance) / sigmaE;
                transmittance *= stepTransmittance;
            }
            else if (++emptyRun >= kFineToCoarseEmpty)
            {
                coarseMode = true;
                lastCoarseDt = 0.0;
            }

            if (transmittance <= 0.001)
            {
                break;
            }
            sampleT += stepT;
        }

        if (rayHitPosWeight > 0.0)
        {
            rayHitPos /= rayHitPosWeight;

            // Convert to camera-relative meters for projection
            float3 rayHitCameraRelative = rayHitPos - worldPos;
            float4 rayInH = mul(kCam.viewProjection, float4(kCam.cameraPosition.xyz + rayHitCameraRelative, 1.0)); // viewProjection takes ABSOLUTE world pos; rayHitCameraRelative is a delta
            cloudZ = rayInH.z / rayInH.w;

            const float rayHitDistance = length(rayHitCameraRelative);

            // Aerial perspective: haze between the camera and the cloud, from the same froxel volume the geometry uses.
            // True result = AP_inscatter(0->D) + T_air(0->D) * (cloud_scatter + T_cloud * behind). The sky this gets blended
            // over already holds AP + T_air * behind, so what must be ADDED (premultiplied, over T_cloud * sky) is
            //     T_air * cloud_scatter + AP * (1 - T_cloud).
            // AP is divided by kCloudExposure so that after Composite.shader's 1-exp(-x*kCloudExposure) it sits on the same
            // exposure-1 curve as the sky; otherwise distant clouds come out darker than the sky behind them.
            {
                float3 apScatter, apTransmit;
                sampleCloudAerialPerspective(uv, rayHitDistance, worldPos, worldDir, atmosphere.topRadius, apScatter, apTransmit);
#if CLOUD_AP_DEBUG == 1
                scatteredLight = apScatter * ((1.0 - transmittance) / kCloudExposure);
#elif CLOUD_AP_DEBUG == 2
                // cloud lighting only
#else
                scatteredLight = scatteredLight * apTransmit + apScatter * ((1.0 - transmittance) / kCloudExposure);
#endif
            }
        }

        // Fade the volumetric layer out toward the transition end (the 2D layer takes over).
        scatteredLight *= volumetricFade;
        transmittance = lerp(1.0, transmittance, volumetricFade);
    }

    // ---- 2D layer: column-integrated slab at the cloud top, in FRONT of the volumetric layer (camera above the layer only) ----
    if (twoDimensionalFade > 0.0 && viewHeight > radiusCloudEnd)
    {
        const float tTop = raySphereIntersectNearest(worldPos, worldDir, float3(0.0), radiusCloudEnd);
        const float tPlanet = raySphereIntersectNearest(worldPos, worldDir, float3(0.0), earthRadius);

        if (tTop > 0.0 && tTop < sceneDist && !(tPlanet > 0.0 && tPlanet < tTop))
        {
            const float3 shellPos = worldPos + worldDir * tTop;
            const float shellHeight = length(shellPos);
            const float3 shellUp = shellPos / shellHeight;

            const float columnOd = cloudColumnOpticalDepth(shellUp, (int)cloud.twoDColumnSamples);

            if (columnOd > 0.0)
            {
                const float cosSun = dot(shellUp, sunDirection);

                // Sun enters from above and the average scatterer sits mid-column, so light sees half the column along the
                // (slanted) sun path and the sky sees half along vertical. Same octave/powder lighting as the volumetric layer.
                const float odSun = columnOd * 0.5 / max(cosSun, 0.15);
                const float odSky = columnOd * 0.5;

                const float powder = cloudPowder(odSun, VoL);
                const float sunMs = cloudMultiScatterSun(odSun, VoL, powder);
                const float skyMs = cloudMultiScatterSky(odSky);

                const float3 sunTrans = inTransmittanceLut.SampleLevel(linearClampEdgeSampler,
                    atmosUV(shellHeight, cosSun, atmosphere.bottomRadius, atmosphere.topRadius), 0).rgb;
                const float3 fill = sampleMultiScatter(inMultiScatterLUT, shellHeight, cosSun,
                                                       atmosphere.bottomRadius, atmosphere.topRadius);

                float3 ambient = fill * kCloudSunIlluminance * kAmbientScale * (0.5 + 0.5 * (1.0 - sunDirection.y));
                ambient = lerp(dot(ambient, float3(0.2126, 0.7152, 0.0722)).xxx, ambient, kAmbientSaturation);

                const float3 luminance = sunTrans * sunColor * sunMs + ambient * skyMs;

                // A homogeneous slab lit with constant luminance integrates to luminance * (1 - T), which is what the
                // volumetric energy-conserving step integration converges to.
                const float layerT = exp(-columnOd);
                float3 layerRgb = luminance * (1.0 - layerT);

                float3 apScatter, apTransmit;
                sampleCloudAerialPerspective(uv, tTop, worldPos, worldDir, atmosphere.topRadius, apScatter, apTransmit);
                layerRgb = layerRgb * apTransmit + apScatter * ((1.0 - layerT) / kCloudExposure);

                layerRgb *= twoDimensionalFade;
                const float layerTrans = lerp(1.0, layerT, twoDimensionalFade);

                // Front layer over back layer (premultiplied)
                scatteredLight = layerRgb + layerTrans * scatteredLight;
                transmittance *= layerTrans;

                // Depth for reprojection/occlusion: the shell where it dominates or nothing volumetric was hit
                if (cloudZ <= 0.0 || layerT < 0.5)
                {
                    const float4 rayInH = mul(kCam.viewProjection, float4(kCam.cameraPosition.xyz + (shellPos - worldPos), 1.0));
                    cloudZ = rayInH.z / rayInH.w;
                }
            }
        }
    }

    // The fog march steps from the camera up to the cloud top, so with the camera ABOVE the top its step length goes negative:
    // transmittance grows past 1 and the composite then multiplies cloud alpha by it. Only run it from below the layer.
    if (bFog && viewHeight < radiusCloudEnd)
    {
        const uint kGodRaySteps = 36;

        float stepLength = (radiusCloudEnd - viewHeight) / clamp(worldDir.y, 0.1, 1.0) / float(kGodRaySteps);
        float3 stepRay = worldDir * stepLength;
        float3 rayPosWP = worldPos + stepRay * (fogNoise + 0.5);

        float3 transmittanceTotal = float3(1.0);
        float3 scatteredLightTotal = float3(0.0, 0.0, 0.0);

        float miePhaseValue = hgPhase(0.8, -VoL);
        float rayleighPhaseValue = rayleighPhase(VoL);

        for (uint i = 0; i < kGodRaySteps; i++)
        {
            float3 P0 = rayPosWP;
            float visibilityTerm = 1.0;
            {
                const uint kStepLight = 8;
                float stepL = (cloud.cloudTopRadius - cloud.cloudBottomRadius) / float(kStepLight);
                stepL = stepL / abs(sunDirection.y);
                float3 position = P0;
                position += (P0.y <= cloud.cloudTopRadius) ?
                    sunDirection * (cloud.cloudTopRadius - P0.y) / sunDirection.y : float3(0.0);

                float d = stepL * 0.01;
                float transmittanceShadow = 0.0;
                for (uint j = 0; j < kStepLight; j++)
                {
                    float3 samplePos = position + sunDirection * d;
                    float sampleHeight = length(samplePos);
                    float normalizeHeight = (sampleHeight - cloud.cloudBottomRadius) / (cloud.cloudTopRadius - cloud.cloudBottomRadius);

                    transmittanceShadow += cloudMap(samplePos, normalizeHeight);
                    d += stepL;
                }
                visibilityTerm = exp(-transmittanceShadow * stepL);
            }

            visibilityTerm = lerp(visibilityTerm, 1.0, saturate(1.0 - sunDirection.y * 5.0));

            float3 phaseTimesScattering = float3(miePhaseValue + rayleighPhaseValue);

            float3 atmosphereTransmittance;
            {
                float viewHeight2 = length(P0);
                const float3 upVector = P0 / viewHeight2;
                float viewZenithCosAngle = dot(sunDirection, upVector);
                float2 sampleUv = atmosUV(viewHeight2, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius);
                atmosphereTransmittance = inTransmittanceLut.SampleLevel(linearClampEdgeSampler, sampleUv, 0).rgb;
            }

            float density = getDensity(distance(rayPosWP, worldPos));

            float3 sigmaS = float3(density);
            float3 sigmaE = max(float3(1e-6), sigmaS);
            float3 sactterLitStep = (visibilityTerm * sunColor * phaseTimesScattering * atmosphereTransmittance + skyBackgroundColor) * sigmaS;

            float3 stepTransmittance2 = exp(-sigmaS * stepLength);
            scatteredLightTotal += transmittanceTotal * (sactterLitStep - sactterLitStep * stepTransmittance2) / sigmaE;
            transmittanceTotal *= stepTransmittance2;

            rayPosWP += stepRay;
        }

        lightingFog.w = mean(transmittanceTotal);
        lightingFog.xyz = scatteredLightTotal;
    }

    #if CLOUD_LIGHT_DEBUG != 0
    return float4(dbgVal, 0.0);
#endif
    float4 result = float4(scatteredLight, transmittance);
    if (anyBadFloat(result) || any(isinf(result)))
    {
        result = float4(0.0, 0.0, 0.0, 1.0);
    }

    if (anyBadFloat(lightingFog) || any(isinf(lightingFog)))
    {
        lightingFog = float4(0.0, 0.0, 0.0, 1.0);
    }
    return result;
}

#endif