#ifndef VOLUMETRIC_CLOUD_COMMON_GLSL
#define VOLUMETRIC_CLOUD_COMMON_GLSL

#define kAmbientScale 0.2
#define kAmbientSaturation 0.4 // 0 = grey ambient, 1 = raw sky colour. Clouds scatter near-white; raw sky ambient is what tinted the rims cyan

#define kSkyMsExition 0.5
#define kLightStepMul 1.6 // light-ray step growth (flower: cloudLightStepMul). First step ~35m, 8 steps reach ~2.4km
#define kGroundOcc 0.5
#define kCloudExposure 0.35 // tune: overall cloud brightness. Composite.shader tonemaps with 1-exp(-rgb*kCloudExposure); the aerial-perspective term is pre-divided by this so it lands on the sky's exposure-1 curve.
// Dual-lobe Henyey-Greenstein (octave 0). MS octave n scales both eccentricities by c^n (Wrenninge), so the lobes widen with each octave.
#define kPhaseForwardG 0.7
#define kPhaseBackwardG -0.25
#define kPhaseForwardMix 0.6 // weight of the forward lobe
// Approximate-Mie phase (Jendersie & d'Eon 2023) for octave 0: effective droplet diameter in microns, valid 5..50. ~10-15 is cumulus.
// Larger = narrower, brighter forward peak (stronger silver lining / corona around the sun).
#define kCloudDropletDiameter 10.0
// Noise filtering. The base/detail volumes are 128^3 and now carry a mip chain; the mip sampled follows the march step so features
// finer than the step are averaged out instead of aliasing into per-pixel noise (the reference does the same with per-step mip levels).
#define kCloudNoiseRes 128.0
#define kNoiseLodBias 1.0       // 0 = exactly step-matched (softest), higher = sharper but noisier
#define kDetailBandCells 2.0    // = kDetailFreq0 in DetailNoise.shader: cells per tile of the dominant detail band
#define kMaxMsOctaves 8
// Variable-step view march (HZD-style): step length grows with distance (constant screen-space footprint) and the march
// SEARCHES with kCoarseStepMul x steps (shape-only density) until it finds cloud, then switches to fine steps, reverting to
// coarse after kFineToCoarseEmpty consecutive empty fine samples.
#define kStepGrowth 0.05
#define kCoarseStepMul 2.0
#define kFineToCoarseEmpty 6u
// HZD light march: cone-jittered samples (soft shadows) + one long-range sample (large-scale shadows between bulges)
#define kLightConeSpread 0.15 // was 0.25: wider cones read as per-pixel shading noise until the temporal pass converges
#define kFarShadowWeight 0.5
// HZD detail erosion: remap(base, detail * kDetailErosion * exp(-coverage * 0.75), 1, 0, 1)
#define kDetailErosion 0.35
// cloudMap returns a 0..1 shape value; scene units are metres, so scale to a physical per-metre
// extinction (~0.01-0.05 for cumulus). Without this a single step is already fully opaque.
#define kExtinctionPerMetre 0.02 // was 0.006: with plain Beer on the view ray that left cumulus translucent (1 km of average cloud was only od ~2-4)
// Pushes the soft density ramp toward 1 so the body of a cloud is solid and only the rim stays soft. Monotonic, so the coarse
// (no-erosion) search sample is still an upper bound.
#define kDensityContrast 1.6
#define kCloudSunIlluminance 40.0 // = atmosphereParams.sunIntensity. Scales BOTH the direct sun term and the multi-scatter LUT terms (the LUT is per unit illuminance)
// Lighting debug (shows the term at the first cloud hit, alpha 0 so it overlays opaquely; values are HDR):
// 0 off | 1 sun visibility | 2 ambientLit | 3 groundLit | 4 skyBackgroundColor | 5 sun term (unshadowed, *phase) | 6 optical depth/5 | 7 upScaleColor | 8 sunDirection (rgb = xyz*0.5+0.5)
// 10 full MS sun term (octave sum, powder on octave 0) | 11 sky MS visibility sum/4
#define CLOUD_LIGHT_DEBUG 0
// Aerial-perspective isolation: 0 = normal | 1 = ONLY the cloud's AP term (what the sky-coloured rim is made of) | 2 = cloud lighting only, no AP
#define CLOUD_AP_DEBUG 0
// Sun brightness gain for cloud lighting only. A sunlit cumulus top is ~E/pi radiance but the normalised phase (~1/4pi) + octave sum gives
// ~0.13E, so clouds came out grey next to the sky haze (exposure-1 curve) and thin rims were mostly AP = cyan outlines.
#define kCloudSunBoost 2.5
#include "../Atmosphere/Atmosphere.si"
#include "../Common/Camera.si"

// default set: 1
#include "../Common/Samplers.si"
#include "../Common/DebugNaN.si"

