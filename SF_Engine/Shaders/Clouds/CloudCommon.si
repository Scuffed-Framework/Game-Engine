#ifndef VOLUMETRIC_CLOUD_COMMON_GLSL
#define VOLUMETRIC_CLOUD_COMMON_GLSL

#define kAmbientScale 0.2

#define kSkyMsExition 0.5
#define kLightStepMul 1.6 // light-ray step growth (flower: cloudLightStepMul). First step ~35m, 8 steps reach ~2.4km
#define kGroundOcc 0.5
#define kCloudExposure 0.35 // tune: overall cloud brightness. Composite.shader tonemaps with 1-exp(-rgb*kCloudExposure); the aerial-perspective term is pre-divided by this so it lands on the sky's exposure-1 curve.
// Dual-lobe Henyey-Greenstein (octave 0). MS octave n scales both eccentricities by c^n (Wrenninge), so the lobes widen with each octave.
#define kPhaseForwardG 0.7
#define kPhaseBackwardG -0.25
#define kPhaseForwardMix 0.6 // weight of the forward lobe
#define kMaxMsOctaves 8
// cloudMap returns a 0..1 shape value; scene units are metres, so scale to a physical per-metre
// extinction (~0.01-0.05 for cumulus). Without this a single step is already fully opaque.
#define kExtinctionPerMetre 0.006
#define kCloudSunIlluminance 40.0 // = atmosphereParams.sunIntensity. Scales BOTH the direct sun term and the multi-scatter LUT terms (the LUT is per unit illuminance)
// Lighting debug (shows the term at the first cloud hit, alpha 0 so it overlays opaquely; values are HDR):
// 0 off | 1 sun visibility | 2 ambientLit | 3 groundLit | 4 skyBackgroundColor | 5 sun term (unshadowed, *phase) | 6 optical depth/5 | 7 upScaleColor | 8 sunDirection (rgb = xyz*0.5+0.5)
// 10 full MS sun term (octave sum, powder on octave 0) | 11 sky MS visibility sum/4
#define CLOUD_LIGHT_DEBUG 0
#include "../Atmosphere/Atmosphere.si"
#include "../Common/Camera.si"

// default set: 1
#include "../Common/Samplers.si"
#include "../Common/DebugNaN.si"

// Texture bindings with vulkan annotations
[[vk::binding(0, 0)]] [[vk::image_format("rgba16f")]]
RWTexture2D<float4> imageHdrSceneColor;

[[vk::binding(1, 0)]]
Texture2D<float4> inHdrSceneColor;

[[vk::binding(2, 0)]] [[vk::image_format("rgba16f")]]
RWTexture2D<float4> imageCloudRenderTexture;

[[vk::binding(3, 0)]]
Texture2D<float4> inCloudRenderTexture;

[[vk::binding(4, 0)]]
Texture2D<float> inDepth;

[[vk::binding(6, 0)]]
Texture3D<float> inBasicNoise;

[[vk::binding(7, 0)]]
Texture3D<float> inDetailNoise;

[[vk::binding(8, 0)]]
Texture2D<float4> inWeatherTexture;

[[vk::binding(9, 0)]]
Texture2D<float> inCloudCurlNoise;

[[vk::binding(10, 0)]]
Texture2D<float4> inTransmittanceLut;

[[vk::binding(11, 0)]]
Texture2D<float4> inAerialPersp;

[[vk::binding(12, 0)]] [[vk::image_format("rgba16f")]]
RWTexture2D<float4> imageCloudReconstructionTexture;

[[vk::binding(13, 0)]]
Texture2D<float4> inCloudReconstructionTexture;

[[vk::binding(14, 0)]] [[vk::image_format("r32f")]]
RWTexture2D<float4> imageCloudDepthTexture;

[[vk::binding(15, 0)]]
Texture2D<float> inCloudDepthTexture;

[[vk::binding(16, 0)]] [[vk::image_format("r32f")]]
RWTexture2D<float4> imageCloudDepthReconstructionTexture;

[[vk::binding(17, 0)]]
Texture2D<float> inCloudDepthReconstructionTexture;

[[vk::binding(18, 0)]]
Texture2D<float4> inCloudReconstructionTextureHistory;

[[vk::binding(19, 0)]]
Texture2D<float> inCloudDepthReconstructionTextureHistory;

[[vk::binding(20, 0)]]
Sampler2D<float4> inSkyViewLut;

[[vk::binding(21, 0)]]
ConstantBuffer<CloudUBO> kCloud;

[[vk::binding(22, 0)]] [[vk::image_format("rgba16f")]]
RWTexture2D<float4> imageCloudFogRenderTexture;

[[vk::binding(23, 0)]]
Texture2D<float4> inCloudFogRenderTexture;

[[vk::binding(24, 0)]] [[vk::image_format("rgba16f")]]
RWTexture2D<float4> imageCloudFogReconstructionTexture;

[[vk::binding(25, 0)]]
Texture2D<float4> inCloudFogReconstructionTexture;

[[vk::binding(26, 0)]]
Texture2D<float4> inCloudFogReconstructionTextureHistory;

[[vk::binding(27, 0)]]
Sampler2D<float4> inMultiScatterLUT;

[[vk::binding(28, 0)]]
Texture2D<float> inSDSMShadowDepth;

[[vk::binding(29, 0)]]
ConstantBuffer<AtmoUBO> kAtmo;

// Aerial perspective froxel volume (AtmoLUTs::GetAerialPerspectiveLUT, baked every frame in AtmosphereSFERenderpass::PreRender).
// Indexed by SCREEN uv: the bake uses the same invProj/invView as this pass, so a ray's full-res uv works as-is.
[[vk::binding(30, 0)]]
Sampler3D inAerialPerspColorRGBTransR; // rgb = in-scatter (already x sun illuminance), a = T.r
[[vk::binding(32, 0)]]
Sampler3D inAerialPerspTransGB;        // rg = T.gb
[[vk::binding(33, 0)]]
Sampler2D inAerialPerspRange;          // r = distToTravel of this ray (<0: ray misses the atmosphere)

[[vk::binding(31, 0)]]
ConstantBuffer<Camera> kCam;

const static int kBayer4x4[16] = {
    0, 8, 2, 10,
    12, 4, 14, 6,
    3, 11, 1, 9,
    15, 7, 13, 5
};

struct CloudUBO
{
    float cloudBottomRadius;
    float cloudTopRadius;
    float stepCount;
    float lightStepCount;

    float cloudDensityScale;
    float cloudCoverage;

    float time;

    float sdfRangeMetres;
    int frameIndex;

    float cloudDetailScale;
    float cloudBaseNoiseScale;
    float cloudCurlNoiseScale;

    float cloudWeatherUVScale;
    float precipitationBias;
    float FadeDistance2d;
    float fadeSmoothDist;
    
    float2 Wind;
    float Speed;
    float unused;

    // Wrenninge "Oz" multiple-scattering octaves
    float msAttenuation;      // a: extinction falloff per octave
    float msContribution;     // b: energy weight per octave
    float msPhaseAttenuation; // c: eccentricity falloff per octave, g_n = g * (1 - c)^n
    float msOctaves;
};

float saturate(float x) { return clamp(x, 0.0, 1.0); }
float3 saturate(float3 x) { return clamp(x, 0.0, 1.0); }
float mean(float3 x) { return (x.x + x.y + x.z) / 3.0; }

float3 safeNormalize(float3 v, float3 fallback)
{
    float lenSq = dot(v, v);
    return (lenSq > 1e-10) ? v * rsqrt(lenSq) : fallback;
}

float2 safeNormalize(float2 v, float2 fallback)
{
    float lenSq = dot(v, v);
    return (lenSq > 1e-10) ? v * rsqrt(lenSq) : fallback;
}

float getDensity(float heightMeter)
{
    return exp(-heightMeter * 0.001) * 0.001 * 0.001;
}

float remap(float value, float orignalMin, float orignalMax, float newMin, float newMax)
{
    return newMin + (saturate((value - orignalMin) / (orignalMax - orignalMin)) * (newMax - newMin));
}

float raySphereIntersectNearest(float3 origin, float3 direction, float3 center, float radius)
{
    float3 oc = origin - center;
    float b = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float disc = b * b - c;
    if (disc < 0.0) return -1.0;
    float sqrtDisc = sqrt(disc);
    float t = -b - sqrtDisc;
    return t > 0.0 ? t : -1.0;
}

float raySphereIntersectInside(float3 origin, float3 direction, float3 center, float radius)
{
    float3 oc = origin - center;
    float b = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float disc = b * b - c;
    if (disc < 0.0) return -1.0;
    float sqrtDisc = sqrt(disc);
    float t = -b + sqrtDisc;
    return t > 0.0 ? t : -1.0;
}

bool raySphereIntersectOutSide(float3 origin, float3 direction, float3 center, float radius, out float2 t0t1)
{
    float3 oc = origin - center;
    float b = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float disc = b * b - c;
    if (disc < 0.0) { t0t1 = float2(0.0, 0.0); return false; }
    float sqrtDisc = sqrt(disc);
    t0t1.x = -b - sqrtDisc;
    t0t1.y = -b + sqrtDisc;
    return t0t1.y > 0.0;
}

float3 cloudTypeGradient(float type, float normalizeHeight)
{
    float stratus = remap(normalizeHeight, 0.00, 0.10, 0.0, 1.0) * remap(normalizeHeight, 0.15, 0.30, 1.0, 0.0);
    float stratocumulus = remap(normalizeHeight, 0.00, 0.10, 0.0, 1.0) * remap(normalizeHeight, 0.20, 0.55, 1.0, 0.0);
    float cumulus = remap(normalizeHeight, 0.00, 0.10, 0.0, 1.0) * remap(normalizeHeight, 0.10, 0.80, 1.0, 0.2);

    float a = saturate(type * 2.0);
    float b = saturate(type * 2.0 - 1.0);
    return float3(lerp(stratus, stratocumulus, a), lerp(stratocumulus, cumulus, b), 0);
}

float getUniformPhase() { return 1.0 / (4.0 * 3.14159265); }
// VoL = dot(viewDir, sunDir): +1 means looking INTO the sun (forward scatter / silver lining)
// Dual-lobe HG for MS octave n. eccScale = (1 - c)^n (1.0 = the real single-scatter phase).
float cloudPhaseOctave(float VoL, float eccScale)
{
    return lerp(hgPhase(kPhaseBackwardG * eccScale, VoL), hgPhase(kPhaseForwardG * eccScale, VoL), kPhaseForwardMix);
}

float cloudPhase(float VoL)
{
    return cloudPhaseOctave(VoL, 1.0);
}

float dualLobPhase(float forward, float backward, float mixFactor, float VoL)
{
    float phase = (1.0 - mixFactor) * (1.0 + forward * VoL) / (4.0 * 3.14159);
    phase += mixFactor * (1.0 + backward * VoL) / (4.0 * 3.14159);
    return phase;
}

float hgPhase(float g, float cosTheta)
{
    float denom = 1.0 + g * g - 2.0 * g * cosTheta;
    return (1.0 - g * g) / (4.0 * 3.14159 * denom * sqrt(denom));
}

float rayleighPhase(float cosTheta)
{
    return 3.0 * (1.0 + cosTheta * cosTheta) / (16.0 * 3.14159);
}

float getPowderEffect(float depth, float height, float VoL)
{
    float r = VoL * 0.5 + 0.5;
    r = r * r;
    height = height * (1.0 - r) + r;
    return depth * height;
}

// posMeter: world position in METERS (absolute from planet center)
// normalizeHeight: 0=cloud bottom, 1=cloud top
float cloudMap(float3 posMeter, float normalizeHeight)
{
    const float kCoverage = kCloud.cloudCoverage;
    const float kDensity = kCloud.cloudDensityScale;

    const float3 windDirection = float3(kCloud.Wind.x, 0.0, kCloud.Wind.y);
    const float cloudSpeed = kCloud.Speed;

    posMeter += windDirection * normalizeHeight * 500.0;
    float3 posKm = posMeter * 0.001; // Convert to km for noise lookups

    float3 windOffset = (windDirection + float3(0.0, 0.1, 0.0)) * kCloud.time * cloudSpeed;

    float2 sampleUv = posKm.xz * kCloud.cloudWeatherUVScale;
    float4 weatherValue = inWeatherTexture.SampleLevel(linearRepeatSampler, sampleUv, 0);

    float localCoverage = inCloudCurlNoise.SampleLevel(linearRepeatSampler, (kCloud.time * cloudSpeed * 50.0 + posMeter.xz) * 0.000001 + 0.5, 0).x;
    localCoverage = saturate(localCoverage * 3.0 - 0.75) * 0.2;

    // weather.x is now a contrast-stretched 0..1 (mean ~0.5); kCoverage*2 makes the slider's default 0.5 mean "average".
    float coverage = saturate(kCoverage * 2.0 * (localCoverage + weatherValue.x));
    
    float3 g = cloudTypeGradient(weatherValue.b, normalizeHeight); 
    float gradienShape = weatherValue.b < 0.5 ? g.x : g.y;

    float basicNoise = inBasicNoise.SampleLevel(linearRepeatSampler, (posKm + windOffset) * float3(kCloud.cloudBaseNoiseScale), 0).x;
    float basicCloudNoise = gradienShape * basicNoise;

    float basicCloudWithCoverage = coverage * remap(basicCloudNoise, 1.0 - coverage, 1, 0, 1);

    float3 sampleDetailNoise = posKm - windOffset * 0.15;
    float detailNoiseComposite = inDetailNoise.SampleLevel(linearRepeatSampler, sampleDetailNoise * kCloud.cloudDetailScale, 0).x;
    float detailNoiseMixByHeight = 0.2 * lerp(detailNoiseComposite, 1 - detailNoiseComposite, saturate(normalizeHeight * 10.0));

    float densityShape = saturate(0.01 + normalizeHeight * 1.15) * kDensity *
        remap(normalizeHeight, 0.0, 0.1, 0.0, 1.0) *
        remap(normalizeHeight, 0.8, 1.0, 1.0, 0.0);

    float cloudDensity = remap(basicCloudWithCoverage, detailNoiseMixByHeight, 1.0, 0.0, 1.0);
    return cloudDensity * densityShape * kExtinctionPerMetre;
}

// Optical depth (dimensionless: extinction in 1/m integrated over metres) from `pos` along `dir` through the cloud layer.
// ONE march feeds every multiple-scattering octave: octave n simply sees od * a^n (Wrenninge), so the octave
// count costs no extra cloudMap taps. pos: world position in METERS (absolute from planet center).
float cloudLightOpticalDepth(float3 pos, float3 dir, int lightSteps)
{
    const float layerThickness = kCloud.cloudTopRadius - kCloud.cloudBottomRadius;
    float stepL = layerThickness / float(lightSteps) / 16.0; // FIRST step; grows by kLightStepMul
    float travelled = 0.0;
    float od = 0.0;

    for (int j = 0; j < lightSteps; j++)
    {
        float3 samplePos = pos + dir * (travelled + 0.5 * stepL);
        float normalizeHeight = (length(samplePos) - kCloud.cloudBottomRadius) / layerThickness;
        od += cloudMap(samplePos, normalizeHeight) * stepL;
        travelled += stepL;
        stepL *= kLightStepMul;
    }
    return od;
}

// Wrenninge et al. multiple-scattering octaves (Sony Imageworks, Oz the Great and Powerful):
//   L = sum_n  b^n * phase(g * (1-c)^n) * exp(-od * a^n)
// a = attenuation (light penetrates deeper each octave), b = contribution (energy per octave), c = phase attenuation.
// `powder` multiplies octave 0 ONLY: dark powder edges are a single-scatter effect, and applying them to the MS octaves
// would black out thin edges that multiple scattering exists to fill back in.
// Returns the phase-weighted sun visibility; multiply by the sun colour.
float cloudMultiScatterSun(float od, float VoL, float powder)
{
    const int octaves = clamp((int)kCloud.msOctaves, 1, kMaxMsOctaves);
    float a = 1.0;
    float b = 1.0;
    float ecc = 1.0;
    float L = 0.0;

    for (int n = 0; n < octaves; n++)
    {
        const float phase = cloudPhaseOctave(VoL, ecc);
        const float beers = exp(-od * a);
        L += b * phase * beers * (n == 0 ? powder : 1.0);

        a *= kCloud.msAttenuation;
        b *= kCloud.msContribution;
        ecc *= 1.0 - kCloud.msPhaseAttenuation;
    }
    return L;
}

// Same octave series for the sky/ambient term: isotropic, so no phase and no powder.
float cloudMultiScatterSky(float od)
{
    const int octaves = clamp((int)kCloud.msOctaves, 1, kMaxMsOctaves);
    float a = 1.0;
    float b = 1.0;
    float L = 0.0;

    for (int n = 0; n < octaves; n++)
    {
        L += b * exp(-od * a);
        a *= kCloud.msAttenuation;
        b *= kCloud.msContribution;
    }
    return L;
}

// Aerial perspective between the camera and a cloud hit, from the same froxel volume the geometry path uses
// (Atmosphere.shader::sampleAerialPerspective). uv = screen uv of this ray, dist = metres from the camera to the hit.
void sampleCloudAerialPerspective(float2 uv, float dist, float3 camPos, float3 dir, float topRadius,
                                  out float3 outScatter, out float3 outTransmit)
{
    outScatter = float3(0.0);
    outTransmit = float3(1.0);

    const float maxDist = inAerialPerspRange.SampleLevel(uv, 0.0).r;
    if (!(maxDist > 0.0))
        return; // ray misses the atmosphere (bake wrote -1), or the range texel is NaN

    // The bake uses quadratic slices (p*p*maxDist) only while the camera is inside the atmosphere, linear slices from
    // space, and measures distance from the atmosphere ENTRY point when starting outside it.
    const bool insideAtmo = length(camPos) < topRadius;
    float d = dist;
    if (!insideAtmo)
        d = max(dist - max(raySphereIntersect(camPos, dir, topRadius).x, 0.0), 0.0);

    float t = saturate(d / maxDist);
    if (insideAtmo)
        t = sqrt(t);

    uint lutW, lutH, lutD;
    inAerialPerspColorRGBTransR.GetDimensions(lutW, lutH, lutD);
    const float sliceCount = float(max(lutD, 1u));

    // Slice i holds the accumulation out to ((i+1)/N)^2 * maxDist but texel i is CENTRED at (i+0.5)/N, so sample at
    // t - 0.5/N; closer than slice 0's far edge, fade in from nothing (optical depth is linear over a short run).
    float nearFade = saturate(t * sliceCount);
    if (insideAtmo)
        nearFade *= nearFade;
    const float w = clamp(t - 0.5 / sliceCount, 0.5 / sliceCount, 1.0 - 0.5 / sliceCount);

    const float4 ct = inAerialPerspColorRGBTransR.SampleLevel(float3(uv, w), 0.0);
    const float2 tgb = inAerialPerspTransGB.SampleLevel(float3(uv, w), 0.0).rg;

    const float3 scatter = ct.rgb * nearFade;
    const float3 transmit = saturate(lerp(float3(1.0), float3(ct.a, tgb.x, tgb.y), nearFade));

    // The very first bake (AtmoLUTs ctor) runs with a zeroed frame UBO and writes NaN; never let that reach the cloud RT.
    if (any(isnan(scatter)) || any(isinf(scatter)) || any(isnan(transmit)))
        return;

    outScatter = scatter;
    outTransmit = transmit;
}

float4 cloudColorCompute(
    CloudUBO cloud,
    AtmoUBO atmosphere,
    float2 uv,
    float blueNoise,
    inout float cloudZ,
    int2 workPos,
    float3 worldDir,
    bool bFog,
    inout float4 lightingFog,
    float fogNoise)
{
    float3 worldPos = kAtmo.cameraPos.xyz-kAtmo.planetPos.xyz;

    lightingFog.w = -1.0;

    float earthRadius = atmosphere.bottomRadius;
    float radiusCloudStart = cloud.cloudBottomRadius;
    float radiusCloudEnd = cloud.cloudTopRadius;

    float viewHeight = length(worldPos);

    float tMin;
    float tMax;
    bool bEarlyOutCloud = false;

    if (viewHeight < radiusCloudStart)
    {
        // Camera inside atmosphere, below clouds
        float tEarth = raySphereIntersectNearest(worldPos, worldDir, float3(0.0), earthRadius);
        if (tEarth > 0.0)
        {
            bEarlyOutCloud = true;
        }

        tMin = raySphereIntersectInside(worldPos, worldDir, float3(0.0), radiusCloudStart);
        tMax = raySphereIntersectInside(worldPos, worldDir, float3(0.0), radiusCloudEnd);
    }
    else if (viewHeight > radiusCloudEnd)
    {
        // Camera above clouds (space)
        float2 t0t1;
        const bool bIntersectionEnd = raySphereIntersectOutSide(worldPos, worldDir, float3(0.0), radiusCloudEnd, t0t1);
        if (!bIntersectionEnd)
        {
            bEarlyOutCloud = true;
        }

        float2 t2t3;
        const bool bIntersectionStart = raySphereIntersectOutSide(worldPos, worldDir, float3(0.0), radiusCloudStart, t2t3);
        if (bIntersectionStart)
        {
            tMin = t0t1.x;
            tMax = t2t3.x;
        }
        else
        {
            tMin = t0t1.x;
            tMax = t0t1.y;
        }
    }
    else
    {
        // Camera inside cloud layer
        float tStart = raySphereIntersectNearest(worldPos, worldDir, float3(0.0), radiusCloudStart);
        if (tStart > 0.0)
        {
            tMax = tStart;
        }
        else
        {
            tMax = raySphereIntersectInside(worldPos, worldDir, float3(0.0), radiusCloudEnd);
        }
        tMin = 0.0;
    }

    tMin = max(tMin, 0.0);
    tMax = max(tMax, 0.0);

    float cloudMaxTracingDist = 300000.0; // 300km max trace
    if (tMax <= tMin || tMin > cloudMaxTracingDist)
    {
        bEarlyOutCloud = true;
    }

    const float marchingDistance = min(cloudMaxTracingDist, tMax - tMin);
    tMax = tMin + marchingDistance;

    const float StepCount = cloud.stepCount;
    const uint stepCountUnit = (uint)StepCount;
    const float stepT = (tMax - tMin) / StepCount;

    float sampleT = tMin + 0.001 * stepT;
    sampleT += stepT * blueNoise;

    float3 sunColor = float3(kCloudSunIlluminance); // phase has a 1/(4*pi) factor, so the sun needs ~4*pi to compete with the sky LUT
    float3 sunDirection = normalize(kAtmo.sunDir.xyz);

    float VoL = dot(worldDir, sunDirection);

    float3 skyBackgroundColor = GetSkyAmbientColor(worldPos, sunDirection, viewHeight, atmosphere.bottomRadius, inSkyViewLut);

    float transmittance = 1.0;
    float3 scatteredLight = float3(0.0, 0.0, 0.0);
    float3 dbgVal = float3(0.0, 0.0, 0.0);
    bool dbgSet = false;

    float3 groundToCloudTransfertIsoScatter;
    {
        float3 upVector = worldPos / viewHeight;
        float cosSunZenith = dot(upVector, sunDirection);
        groundToCloudTransfertIsoScatter = sampleMultiScatter(
            inMultiScatterLUT, viewHeight, cosSunZenith,
            atmosphere.bottomRadius, atmosphere.topRadius);
    }

    if (!bEarlyOutCloud)
    {
        float3 rayHitPos = float3(0.0);
        float rayHitPosWeight = 0.0;

        float3 atmosphereTransmittance0;
        {
            float3 samplePos = sampleT * worldDir + worldPos;
            float sampleHeight = length(samplePos);
            const float3 upVector = samplePos / sampleHeight;
            float viewZenithCosAngle = dot(sunDirection, upVector);
            float2 sampleUv = atmosUV(viewHeight, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius);
            atmosphereTransmittance0 = inTransmittanceLut.SampleLevel(linearClampEdgeSampler, atmosUV(sampleHeight, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius), 0).rgb; // sampleHeight, NOT camera viewHeight: cloud at 1.5-6km still sees a low sun
        }

        float3 atmosphereTransmittance1;
        {
            float3 samplePos = tMax * worldDir + worldPos;
            float sampleHeight = length(samplePos);
            const float3 upVector = samplePos / sampleHeight;
            float viewZenithCosAngle = dot(sunDirection, upVector);
            float2 sampleUv = atmosUV(viewHeight, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius);
            atmosphereTransmittance1 = inTransmittanceLut.SampleLevel(linearClampEdgeSampler, atmosUV(sampleHeight, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius), 0).rgb;
        }

        float3 upScaleColor;
        {
            float3 samplePos = sampleT * worldDir + worldPos;
            float sampleHeight = length(samplePos);
            float3 sampleUp = samplePos / sampleHeight;
            float cosSunZenithLocal = dot(sampleUp, sunDirection);
            upScaleColor = sampleMultiScatter(inMultiScatterLUT, sampleHeight, cosSunZenithLocal,
                                              atmosphere.bottomRadius, atmosphere.topRadius);
        }

        for (uint i = 0; i < stepCountUnit; i++)
        {
            float3 samplePos = sampleT * worldDir + worldPos;
            float sampleHeight = length(samplePos);
            float normalizeHeight = (sampleHeight - cloud.cloudBottomRadius) / (cloud.cloudTopRadius - cloud.cloudBottomRadius);

            float3 atmosphereTransmittance = lerp(atmosphereTransmittance0, atmosphereTransmittance1, saturate(sampleT / marchingDistance));

            float stepCloudDensity = cloudMap(samplePos, normalizeHeight);

            if (stepCloudDensity > 0.0)
            {
                // stepT is in meters, density is per meter, so opticalDepth is dimensionless
                float opticalDepth = stepCloudDensity * stepT;
                float stepTransmittance = max(exp(-opticalDepth), exp(-opticalDepth * 0.25) * 0.7);

                // Cloud "hit" position (feeds cloudZ for reprojection and the aerial-perspective distance): weight each
                // step by the opacity it contributes. It used to be accumulated before the density test, so empty steps
                // voted too and the hit landed mid-way along the whole empty ray instead of at the cloud.
                const float hitWeight = transmittance * (1.0 - stepTransmittance);
                rayHitPos += samplePos * hitWeight;
                rayHitPosWeight += hitWeight;

                const int lightSteps = (int)cloud.lightStepCount;
                const float3 sampleUp = samplePos / sampleHeight;
                const float odSun = cloudLightOpticalDepth(samplePos, sunDirection, lightSteps);
                const float odSky = cloudLightOpticalDepth(samplePos, sampleUp, lightSteps); // sky light comes from ABOVE: radial up at the sample, not world +Y (they diverge ~2.5 deg at 280 km)

                float powderEffect;
                {
                    float densityN = stepCloudDensity / kExtinctionPerMetre;
                    float depthProbability = pow(clamp(densityN * 8.0, 0.0, 1.0), remap(normalizeHeight, 0.3, 0.85, 0.5, 2.0));
                    depthProbability += 0.05;

                    float verticalProbability = pow(remap(normalizeHeight, 0.07, 0.22, 0.1, 1.0), 0.8);
                    powderEffect = getPowderEffect(depthProbability, verticalProbability, VoL);
                }

                float3 sunlightTerm = atmosphereTransmittance * sunColor;

                // Multiple-scattering octave sums (Wrenninge/Oz): sun = sum b^n * dualHG(g c^n) * beers(od a^n), powder on octave 0.
                const float sunMs = cloudMultiScatterSun(odSun, VoL, powderEffect);
                const float skyMs = cloudMultiScatterSky(odSky);

                float3 groundLit = lerp(skyBackgroundColor, groundToCloudTransfertIsoScatter * kCloudSunIlluminance, saturate(cloud.cloudBaseNoiseScale - normalizeHeight))
                    * saturate(1.0 - kGroundOcc + normalizeHeight) * 1.0;

                float3 ambientLit = upScaleColor * kCloudSunIlluminance * kAmbientScale
                    * lerp(0.5, 1.0, normalizeHeight)
                    * (0.5 + 0.5 * (1.0 - sunDirection.y));

                #if CLOUD_LIGHT_DEBUG != 0
                if (!dbgSet)
                {
                    dbgSet = true;
#if CLOUD_LIGHT_DEBUG == 1
                    dbgVal = exp(-odSun).xxx;
#elif CLOUD_LIGHT_DEBUG == 2
                    dbgVal = ambientLit;
#elif CLOUD_LIGHT_DEBUG == 3
                    dbgVal = groundLit;
#elif CLOUD_LIGHT_DEBUG == 4
                    dbgVal = skyBackgroundColor;
#elif CLOUD_LIGHT_DEBUG == 5
                    dbgVal = sunlightTerm * cloudPhase(VoL) * powderEffect;
#elif CLOUD_LIGHT_DEBUG == 6
                    dbgVal = (stepCloudDensity * stepT / 5.0).xxx;
#elif CLOUD_LIGHT_DEBUG == 7
                    dbgVal = upScaleColor;
#elif CLOUD_LIGHT_DEBUG == 8
                    dbgVal = sunDirection * 0.5 + 0.5;
#elif CLOUD_LIGHT_DEBUG == 10
                    dbgVal = sunlightTerm * sunMs;
#elif CLOUD_LIGHT_DEBUG == 11
                    dbgVal = (skyMs * 0.25).xxx;
#elif CLOUD_LIGHT_DEBUG == 9
                    {
                        // QUADRANTS (shown as 1-exp(-4x) so tiny values are visible):
                        // TL ambientLit | TR groundLit | BL sun term (unshadowed) | BR skyBackgroundColor
                        float3 sunTerm = sunlightTerm * cloudPhase(VoL) * powderEffect;
                        bool qr = uv.x >= 0.5;
                        bool qb = uv.y >= 0.5;
                        float3 pick = skyBackgroundColor;
                        if (!qb && !qr) pick = ambientLit;
                        else if (!qb && qr) pick = groundLit;
                        else if (qb && !qr) pick = sunTerm;
                        dbgVal = pick; // RAW HDR value: hover a pixel in RenderDoc and read it
                    }
#endif
                }
#endif
                // Beer-Lambert visibility x dual-lobe HG x Wrenninge MS octaves. Energy-conserving integration over the step:
                // S is the in-scattered radiance at the sample, (S - S*T_step)/sigmaE integrates it across the step's extinction.
                const float3 albedo = float3(1.0);
                const float sigmaS = stepCloudDensity;
                const float sigmaE = max(sigmaS, 1e-8);

                const float3 luminance = sunlightTerm * sunMs + ambientLit * skyMs + groundLit;
                const float3 S = sigmaS * albedo * luminance;

                scatteredLight += transmittance * (S - S * stepTransmittance) / sigmaE;
                transmittance *= stepTransmittance;
            }

            if (transmittance <= 0.001)
            {
                break;
            }
            sampleT += stepT;
        }

        if (rayHitPosWeight > 0.0)
        {
            rayHitPos /= rayHitPosWeight;

            // Convert to camera-relative meters for projection
            float3 rayHitCameraRelative = rayHitPos - worldPos;
            float4 rayInH = mul(kCam.viewProjection, float4(kCam.cameraPosition.xyz + rayHitCameraRelative, 1.0)); // viewProjection takes ABSOLUTE world pos; rayHitCameraRelative is a delta
            cloudZ = rayInH.z / rayInH.w;

            const float rayHitDistance = length(rayHitCameraRelative);

            // Aerial perspective: haze between the camera and the cloud, from the same froxel volume the geometry uses.
            // True result = AP_inscatter(0->D) + T_air(0->D) * (cloud_scatter + T_cloud * behind). The sky this gets blended
            // over already holds AP + T_air * behind, so what must be ADDED (premultiplied, over T_cloud * sky) is
            //     T_air * cloud_scatter + AP * (1 - T_cloud).
            // AP is divided by kCloudExposure so that after Composite.shader's 1-exp(-x*kCloudExposure) it sits on the same
            // exposure-1 curve as the sky; otherwise distant clouds come out darker than the sky behind them.
            {
                float3 apScatter, apTransmit;
                sampleCloudAerialPerspective(uv, rayHitDistance, worldPos, worldDir, atmosphere.topRadius, apScatter, apTransmit);
                scatteredLight = scatteredLight * apTransmit + apScatter * ((1.0 - transmittance) / kCloudExposure);
            }
        }
    }

    if (bFog)
    {
        const uint kGodRaySteps = 36;

        float stepLength = (radiusCloudEnd - viewHeight) / clamp(worldDir.y, 0.1, 1.0) / float(kGodRaySteps);
        float3 stepRay = worldDir * stepLength;
        float3 rayPosWP = worldPos + stepRay * (fogNoise + 0.5);

        float3 transmittanceTotal = float3(1.0);
        float3 scatteredLightTotal = float3(0.0, 0.0, 0.0);

        float miePhaseValue = hgPhase(0.8, -VoL);
        float rayleighPhaseValue = rayleighPhase(VoL);

        for (uint i = 0; i < kGodRaySteps; i++)
        {
            float3 P0 = rayPosWP;
            float visibilityTerm = 1.0;
            {
                const uint kStepLight = 8;
                float stepL = (cloud.cloudTopRadius - cloud.cloudBottomRadius) / float(kStepLight);
                stepL = stepL / abs(sunDirection.y);
                float3 position = P0;
                position += (P0.y <= cloud.cloudTopRadius) ?
                    sunDirection * (cloud.cloudTopRadius - P0.y) / sunDirection.y : float3(0.0);

                float d = stepL * 0.01;
                float transmittanceShadow = 0.0;
                for (uint j = 0; j < kStepLight; j++)
                {
                    float3 samplePos = position + sunDirection * d;
                    float sampleHeight = length(samplePos);
                    float normalizeHeight = (sampleHeight - cloud.cloudBottomRadius) / (cloud.cloudTopRadius - cloud.cloudBottomRadius);

                    transmittanceShadow += cloudMap(samplePos, normalizeHeight);
                    d += stepL;
                }
                visibilityTerm = exp(-transmittanceShadow * stepL);
            }

            visibilityTerm = lerp(visibilityTerm, 1.0, saturate(1.0 - sunDirection.y * 5.0));

            float3 phaseTimesScattering = float3(miePhaseValue + rayleighPhaseValue);

            float3 atmosphereTransmittance;
            {
                float viewHeight2 = length(P0);
                const float3 upVector = P0 / viewHeight2;
                float viewZenithCosAngle = dot(sunDirection, upVector);
                float2 sampleUv = atmosUV(viewHeight2, viewZenithCosAngle, atmosphere.bottomRadius, atmosphere.topRadius);
                atmosphereTransmittance = inTransmittanceLut.SampleLevel(linearClampEdgeSampler, sampleUv, 0).rgb;
            }

            float density = getDensity(distance(rayPosWP, worldPos));

            float3 sigmaS = float3(density);
            float3 sigmaE = max(float3(1e-6), sigmaS);
            float3 sactterLitStep = (visibilityTerm * sunColor * phaseTimesScattering * atmosphereTransmittance + skyBackgroundColor) * sigmaS;

            float3 stepTransmittance2 = exp(-sigmaS * stepLength);
            scatteredLightTotal += transmittanceTotal * (sactterLitStep - sactterLitStep * stepTransmittance2) / sigmaE;
            transmittanceTotal *= stepTransmittance2;

            rayPosWP += stepRay;
        }

        lightingFog.w = mean(transmittanceTotal);
        lightingFog.xyz = scatteredLightTotal;
    }

    #if CLOUD_LIGHT_DEBUG != 0
    return float4(dbgVal, 0.0);
#endif
    float4 result = float4(scatteredLight, transmittance);
    if (anyBadFloat(result) || any(isinf(result)))
    {
        result = float4(0.0, 0.0, 0.0, 1.0);
    }

    if (anyBadFloat(lightingFog) || any(isinf(lightingFog)))
    {
        lightingFog = float4(0.0, 0.0, 0.0, 1.0);
    }
    return result;
}

#endif